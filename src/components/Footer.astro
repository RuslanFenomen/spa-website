---
import Camera from "@lucide/astro/icons/camera";
import Send from "@lucide/astro/icons/send";
import MapPin from "@lucide/astro/icons/map-pin";
import Clock from "@lucide/astro/icons/clock";
import { navLinks, salon } from "../data/content";
---

<footer class="border-t border-taupe/10 bg-forest text-cream">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-16 sm:px-8 lg:grid-cols-12 lg:py-20">
    <div class="lg:col-span-4">
      <p class="font-serif text-2xl tracking-[0.2em] uppercase">{salon.name}</p>
      <p class="mt-4 max-w-sm text-sm leading-relaxed font-light text-cream/70">
        Тихая роскошь ритуала: авторский массаж, органическая косметика и пространство,
        в котором не нужно ничего доказывать.
      </p>
      <div class="mt-6 flex gap-4">
        <a
          href={salon.instagram}
          class="text-cream/70 transition-all duration-300 hover:text-cream"
          aria-label="Instagram"
        >
          <Camera size={18} stroke-width={1.4} />
        </a>
        <a
          href={salon.telegram}
          class="text-cream/70 transition-all duration-300 hover:text-cream"
          aria-label="Telegram"
        >
          <Send size={18} stroke-width={1.4} />
        </a>
      </div>
    </div>

    <nav class="lg:col-span-2" aria-label="Навигация в подвале">
      <p class="mb-4 text-xs tracking-[0.28em] text-sage uppercase">Салон</p>
      <ul class="space-y-3 text-sm text-cream/75">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="transition-all duration-300 hover:text-cream">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="lg:col-span-3">
      <p class="mb-4 text-xs tracking-[0.28em] text-sage uppercase">Контакты</p>
      <ul class="space-y-3 text-sm text-cream/75">
        <li class="flex items-start gap-2">
          <MapPin size={16} class="mt-0.5 shrink-0" stroke-width={1.4} />
          {salon.address}
        </li>
        <li class="flex items-start gap-2">
          <Clock size={16} class="mt-0.5 shrink-0" stroke-width={1.4} />
          {salon.hours}
        </li>
        <li>
          <a href={salon.phoneHref} class="transition-all duration-300 hover:text-cream">
            {salon.phoneDisplay}
          </a>
        </li>
      </ul>
    </div>

    <div class="lg:col-span-3">
      <p class="mb-4 text-xs tracking-[0.28em] text-sage uppercase">Закрытые предложения</p>
      <p class="mb-4 text-sm font-light text-cream/70">
        Письма раз в месяц: сезонные ритуалы и сертификаты, которых нет на сайте.
      </p>
      <form id="subscribe-form" class="space-y-3">
        <label class="sr-only" for="subscribe-email">Электронная почта</label>
        <input
          id="subscribe-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="ваш@email.ru"
          class="w-full border border-cream/20 bg-transparent px-4 py-3 text-sm text-cream outline-none placeholder:text-cream/40 focus:border-sage"
        />
        <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" />
        <button
          type="submit"
          class="w-full border border-sage/50 px-4 py-3 text-xs tracking-[0.2em] uppercase transition-all duration-300 hover:bg-sage hover:text-forest"
        >
          Подписаться
        </button>
        <p id="subscribe-status" class="text-xs text-cream/60" role="status"></p>
      </form>
    </div>
  </div>
  <div class="border-t border-cream/10 px-5 py-6 text-center text-xs tracking-wide text-cream/45 sm:px-8">
    © {new Date().getFullYear()} {salon.name}. Все права защищены.
  </div>
</footer>

<script>
  const form = document.getElementById("subscribe-form") as HTMLFormElement | null;
  const status = document.getElementById("subscribe-status");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status) return;
    const data = new FormData(form);
    status.textContent = "Отправляем…";
    try {
      const response = await fetch("/api/telegram", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          type: "subscribe",
          email: String(data.get("email") ?? ""),
          website: String(data.get("website") ?? ""),
        }),
      });
      if (!response.ok) throw new Error("fail");
      status.textContent = "Вы в списке. Спасибо за доверие.";
      form.reset();
    } catch {
      status.textContent = "Не удалось отправить. Напишите нам на почту.";
    }
  });
</script>
