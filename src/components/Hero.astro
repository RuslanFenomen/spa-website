---
import DecorativeLeaves from "./DecorativeLeaves.astro";
---

<section
  class="relative isolate flex min-h-[calc(100dvh-4.5rem)] flex-col overflow-hidden bg-forest"
  aria-labelledby="hero-heading"
>
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 bg-gradient-to-br from-[#3a4638] via-forest to-[#1c231c]"></div>
    <div class="absolute -left-[18%] top-[-20%] h-[70%] w-[70%] rounded-full bg-sage/25 blur-3xl"></div>
    <div class="absolute right-[-12%] bottom-[-24%] h-[60%] w-[55%] rounded-full bg-sand/15 blur-3xl"></div>
    <div
      class="absolute inset-0 opacity-[0.1]"
      style="background-image: radial-gradient(circle at 1px 1px, #f5f2eb 1px, transparent 0); background-size: 26px 26px;"
    >
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-forest/80 via-forest/35 to-forest/15"></div>
  </div>
  <DecorativeLeaves />

  <div class="relative z-10 mx-auto flex w-full max-w-7xl flex-1 flex-col justify-center px-5 py-24 sm:px-8">
    <p class="mb-6 text-xs tracking-[0.42em] text-sand uppercase sm:text-sm">Авторский спа-салон</p>
    <h1
      id="hero-heading"
      class="max-w-4xl font-serif text-5xl leading-[1.05] font-medium tracking-wide text-cream sm:text-6xl md:text-7xl lg:text-8xl"
    >
      Гармония души и тела
    </h1>
    <p class="mt-8 max-w-xl text-base leading-relaxed font-light text-cream/80 sm:text-lg">
      Авторские методики массажа, премиальная органическая косметика и атмосфера абсолютного покоя —
      без спешки, без лишнего света, без чужих разговоров за стеной.
    </p>
    <div class="mt-12 flex flex-col gap-4 sm:flex-row sm:items-center">
      <button
        type="button"
        data-booking-open
        class="inline-flex items-center justify-center border border-cream/40 px-8 py-3.5 text-sm tracking-[0.2em] text-cream uppercase transition-all duration-300 hover:border-cream hover:bg-cream/10"
      >
        Записаться на сеанс
      </button>
      <a
        href="#services"
        class="inline-flex items-center justify-center px-8 py-3.5 text-sm tracking-[0.2em] text-cream/80 uppercase transition-all duration-300 hover:text-cream"
      >
        Исследовать услуги
      </a>
    </div>
  </div>
</section>
