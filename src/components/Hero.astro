---
---

<section
  class="relative isolate flex min-h-dvh flex-col overflow-hidden bg-slate"
  aria-labelledby="hero-heading"
>
  <!-- Stylish image placeholder: layered organic washes, no stock photo required -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0 bg-gradient-to-br from-[#3d4840] via-[#2a312e] to-[#1f2422]"
    >
    </div>
    <div
      class="absolute -left-[20%] top-[-18%] h-[70%] w-[70%] rounded-full bg-sage/25 blur-3xl"
    >
    </div>
    <div
      class="absolute -right-[10%] bottom-[-20%] h-[65%] w-[60%] rounded-full bg-sand/20 blur-3xl"
    >
    </div>
    <div
      class="absolute left-1/2 top-1/3 h-[50%] w-[40%] -translate-x-1/2 rounded-full bg-[#c4b39a]/10 blur-3xl"
    >
    </div>
    <div
      class="absolute inset-0 opacity-[0.12]"
      style="background-image: radial-gradient(circle at 1px 1px, #f6f1ea 1px, transparent 0); background-size: 28px 28px;"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-slate/80 via-slate/35 to-slate/20"
    >
    </div>
  </div>

  <header class="relative z-10 px-6 pt-8 sm:px-10 lg:px-16">
    <div class="mx-auto flex max-w-7xl items-center justify-between">
      <p class="font-serif text-xl tracking-[0.28em] text-cream uppercase">
        Auréa
      </p>
      <nav aria-label="Основная навигация">
        <a
          href="#services"
          class="text-sm font-light tracking-[0.18em] text-cream/80 uppercase transition-all duration-300 hover:text-cream"
        >
          Услуги
        </a>
      </nav>
    </div>
  </header>

  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl flex-1 flex-col justify-center px-6 py-24 sm:px-10 lg:px-16"
  >
    <p
      class="mb-6 text-xs tracking-[0.42em] text-sand uppercase sm:text-sm"
    >
      Авторский спа-салон
    </p>
    <h1
      id="hero-heading"
      class="max-w-4xl font-serif text-5xl leading-[1.05] font-medium tracking-wide text-cream sm:text-6xl md:text-7xl lg:text-8xl"
    >
      Гармония души и тела
    </h1>
    <p
      class="mt-8 max-w-xl text-base leading-relaxed font-light text-cream/80 sm:text-lg"
    >
      Авторские методики массажа, созданные, чтобы восстановить ритм тела
      и вернуть ощущение внутренней тишины.
    </p>
    <div class="mt-12">
      <a
        href="#services"
        class="inline-flex items-center border border-cream/40 px-8 py-3.5 text-sm tracking-[0.22em] text-cream uppercase transition-all duration-300 hover:border-cream hover:bg-cream/10"
      >
        Записаться
      </a>
    </div>
  </div>
</section>
