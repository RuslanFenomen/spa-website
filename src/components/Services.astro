---
const services = [
  {
    title: "Классический массаж",
    description:
      "Мягкая, глубокая работа с мышцами: снимаем напряжение и возвращаем телу естественную лёгкость.",
    duration: "60–90 мин",
    span: "md:col-span-8 min-h-[20rem]",
    tone: "bg-sage/20 border-sage/30 hover:bg-sage/30",
  },
  {
    title: "Стоун-терапия",
    description:
      "Тёплые базальтовые камни и медленные движения для глубокого расслабления.",
    duration: "75 мин",
    span: "md:col-span-4 min-h-[20rem]",
    tone: "bg-sand/50 border-sand-deep/40 hover:bg-sand/80",
  },
  {
    title: "SPA-ритуалы",
    description:
      "Авторские ритуалы с маслами, паром и тишиной — полный цикл восстановления.",
    duration: "90–120 мин",
    span: "md:col-span-4 min-h-[18rem]",
    tone: "bg-cream border-sand/70 hover:border-sage/40 hover:bg-sand/30",
  },
  {
    title: "Лифтинг-массаж",
    description:
      "Скульптурная техника для лица и шеи: тонус кожи без агрессивного воздействия.",
    duration: "50 мин",
    span: "md:col-span-8 min-h-[18rem]",
    tone: "bg-sage-deep/10 border-sage/25 hover:bg-sage/15",
  },
];
---

<section
  id="services"
  class="bg-cream px-6 py-20 sm:px-10 sm:py-28 lg:px-16"
  aria-labelledby="services-heading"
>
  <div class="mx-auto max-w-7xl">
    <div
      class="mb-14 flex flex-col gap-6 md:mb-20 md:flex-row md:items-end md:justify-between"
    >
      <div class="max-w-xl">
        <p class="mb-4 text-xs tracking-[0.36em] text-sage-deep uppercase">
          Наши практики
        </p>
        <h2
          id="services-heading"
          class="font-serif text-4xl tracking-wide text-slate sm:text-5xl"
        >
          Услуги
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-relaxed font-light text-slate-muted md:text-right">
        Четыре направления, собранные вокруг одного принципа: меньше спешки,
        больше внимания к телу.
      </p>
    </div>

    <ul class="grid grid-cols-1 gap-4 md:grid-cols-12 md:gap-5">
      {
        services.map((service) => (
          <li class={service.span}>
            <article
              class:list={[
                "group flex h-full flex-col justify-between rounded-2xl border p-7 sm:p-9",
                "transition-all duration-300",
                service.tone,
              ]}
            >
              <div>
                <p class="mb-8 text-[0.7rem] tracking-[0.28em] text-slate-muted uppercase">
                  {service.duration}
                </p>
                <h3 class="font-serif text-2xl tracking-wide text-slate sm:text-3xl">
                  {service.title}
                </h3>
                <p class="mt-4 max-w-md text-sm leading-relaxed font-light text-slate-muted sm:text-base">
                  {service.description}
                </p>
              </div>
              <span
                class="mt-10 inline-flex items-center gap-2 text-xs tracking-[0.2em] text-sage-deep uppercase transition-all duration-300 group-hover:gap-3 group-hover:text-slate"
              >
                Подробнее
                <span aria-hidden="true">→</span>
              </span>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
