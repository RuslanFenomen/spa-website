---
import Layout from "../layouts/Layout.astro";
import BookingForm from "../components/BookingForm.astro";
import { salon } from "../data/content";
import MapPin from "@lucide/astro/icons/map-pin";
import Clock from "@lucide/astro/icons/clock";
import Phone from "@lucide/astro/icons/phone";
import Mail from "@lucide/astro/icons/mail";
---

<Layout
  title="Контакты и запись — Aura SPA"
  description="Адрес, часы работы, карта и форма записи в Aura SPA."
>
  <main id="main">
    <section class="px-5 py-16 sm:px-8 sm:py-24">
      <div class="mx-auto max-w-7xl">
        <p class="text-xs tracking-[0.36em] text-sage-deep uppercase">Контакты</p>
        <h1 class="mt-4 font-serif text-5xl tracking-wide text-forest sm:text-6xl">Как нас найти</h1>
        <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <li class="rounded-2xl border border-taupe/10 p-5">
            <MapPin size={18} class="text-sage-deep" stroke-width={1.4} />
            <p class="mt-3 text-sm text-taupe">{salon.address}</p>
          </li>
          <li class="rounded-2xl border border-taupe/10 p-5">
            <Clock size={18} class="text-sage-deep" stroke-width={1.4} />
            <p class="mt-3 text-sm text-taupe">{salon.hours}</p>
          </li>
          <li class="rounded-2xl border border-taupe/10 p-5">
            <Phone size={18} class="text-sage-deep" stroke-width={1.4} />
            <a href={salon.phoneHref} class="mt-3 block text-sm text-taupe">{salon.phoneDisplay}</a>
          </li>
          <li class="rounded-2xl border border-taupe/10 p-5">
            <Mail size={18} class="text-sage-deep" stroke-width={1.4} />
            <a href={`mailto:${salon.email}`} class="mt-3 block text-sm text-taupe">{salon.email}</a>
          </li>
        </ul>
      </div>
    </section>

    <section class="px-5 pb-8 sm:px-8">
      <div class="mx-auto max-w-7xl overflow-hidden rounded-3xl border border-taupe/10">
        <iframe
          title="Карта проезда к Aura SPA"
          src={salon.mapEmbed}
          class="h-80 w-full grayscale"
          loading="lazy"></iframe>
      </div>
    </section>

    <section class="px-5 py-16 sm:px-8 sm:py-24" aria-labelledby="contact-form-heading">
      <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-2">
        <div>
          <h2 id="contact-form-heading" class="font-serif text-4xl text-forest">Записаться</h2>
          <p class="mt-4 text-sm font-light text-taupe-muted">
            Заявка уходит администратору в Telegram. Мы перезвоним, подтвердим время и мастера.
          </p>
        </div>
        <div class="rounded-3xl border border-taupe/10 bg-sand/30 p-6 sm:p-8">
          <BookingForm idPrefix="contacts" />
        </div>
      </div>
    </section>
  </main>
</Layout>
