---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import QuickBookBar from "../components/QuickBookBar.astro";
import BookingForm from "../components/BookingForm.astro";
import X from "@lucide/astro/icons/x";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Aura SPA — гармония души и тела",
  description = "Авторские методики массажа, органическая косметика и тихая роскошь ритуала в Aura SPA.",
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Outfit:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="pb-20 md:pb-0">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:bg-cream focus:px-4 focus:py-2 focus:text-taupe"
    >
      Перейти к содержанию
    </a>
    <Navbar />
    <slot />
    <Footer />
    <QuickBookBar />

    <dialog
      id="booking-dialog"
      class="fixed inset-0 z-[70] m-auto w-[min(100%-1.5rem,40rem)] rounded-2xl border border-taupe/10 bg-cream p-0 text-taupe backdrop:bg-forest/50 backdrop:backdrop-blur-sm"
      aria-labelledby="dialog-title"
    >
      <div class="max-h-[90dvh] overflow-y-auto p-6 sm:p-8">
        <div class="mb-6 flex items-start justify-between gap-4">
          <div>
            <p class="text-xs tracking-[0.3em] text-sage-deep uppercase">Aura SPA</p>
            <h2 id="dialog-title" class="mt-2 font-serif text-3xl text-forest">Запись</h2>
          </div>
          <button type="button" data-booking-close class="text-taupe" aria-label="Закрыть окно записи">
            <X size={20} stroke-width={1.4} />
          </button>
        </div>
        <BookingForm idPrefix="dialog" />
      </div>
    </dialog>

    <script>
      const dialog = document.getElementById("booking-dialog") as HTMLDialogElement | null;

      function openBooking(service?: string) {
        if (!dialog) return;
        if (service) {
          const radio = dialog.querySelector(
            `input[name="service"][value="${CSS.escape(service)}"]`,
          ) as HTMLInputElement | null;
          if (radio) radio.checked = true;
        }
        dialog.showModal();
      }

      document.querySelectorAll("[data-booking-open]").forEach((button) => {
        button.addEventListener("click", () => {
          openBooking(button.getAttribute("data-service") ?? undefined);
        });
      });

      document.querySelectorAll("[data-booking-close]").forEach((button) => {
        button.addEventListener("click", () => dialog?.close());
      });

      dialog?.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
    </script>
  </body>
</html>
