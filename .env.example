# Telegram Bot API — серверные секреты, без префикса PUBLIC_
# Создайте бота через @BotFather и получите token.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# ID чата или группы, куда бот будет слать заявки.
# Узнать можно у @userinfobot или через getUpdates после первого сообщения боту.
TELEGRAM_CHAT_ID=123456789
